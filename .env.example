# douyin-video-distiller 配置示例
#
# 用法（Git Bash）：  set -a; source .env; set +a
# 用法（PowerShell）： Get-Content .env | Where-Object { $_ -match '^\s*[A-Z_]+=' } |
#                      ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process') }
# 也可以直接在系统环境变量里设置，不必用 .env 文件。
# 空值 = 使用 dy_config.py 里的默认值。

# 【必填】ima 独立知识库 ID —— 蒸馏笔记写入这里。
# 在 ima 客户端新建一个独立知识库，用 get_addable_knowledge_base_list 查到 ID。
# 只有阶段 4/5（上传入库）需要；采集、下载、转写、蒸馏、lint 不依赖它。
IMA_KB_ID=your_ima_knowledge_base_id

# 【可选】产物根目录（媒体 / run 目录 / 笔记 / 回执）。
# 默认：Windows 有 D 盘时为 D:/douyin-distill，否则 ~/douyin-distill
DOUYIN_DISTILL_ROOT=

# 【可选】发现层队列状态目录。默认 <DOUYIN_DISTILL_ROOT>/_watch
DOUYIN_WATCH_ROOT=

# 【可选】离线 ASR 安装根目录。默认 <DOUYIN_DISTILL_ROOT>/asr
# 若你已有装好的 SenseVoice 环境，把这里指过去即可复用。
WORKBUDDY_ASR_ROOT=

# 【可选】vendored 搜索引擎目录（zhubaohe123/Douyin-api，本仓库不含）。
# 默认 <DOUYIN_DISTILL_ROOT>/_vendor/douyin-api
# 只有用「关键词发现」时需要；不装不影响主链路。
DOUYIN_VENDOR_DIR=
